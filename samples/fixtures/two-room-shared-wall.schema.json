{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://furnaview.dev/schemas/two-room-shared-wall.schema.json",
  "title": "FurnaView two-room building fixture",
  "description": "Single-floor semantic building fixture with two rooms, one shared wall and one door. Coordinates are metres with the floor plane on X/Z and Y up.",
  "type": "object",
  "required": ["id", "revision", "rooms", "walls", "openings"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string" },
    "revision": { "type": "integer", "minimum": 1 },
    "rooms": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/room" }
    },
    "walls": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/wall" }
    },
    "openings": {
      "type": "array",
      "items": { "$ref": "#/$defs/opening" }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "required": ["x", "z"],
      "properties": {
        "x": { "type": "number" },
        "z": { "type": "number" }
      },
      "additionalProperties": false
    },
    "room": {
      "type": "object",
      "required": ["id", "name", "height", "area", "volume", "wallIds"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "area": { "type": "number", "exclusiveMinimum": 0 },
        "volume": { "type": "number", "exclusiveMinimum": 0 },
        "wallIds": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uuid" } }
      },
      "additionalProperties": false
    },
    "wall": {
      "type": "object",
      "required": ["id", "name", "start", "end", "height", "thickness"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1 },
        "start": { "$ref": "#/$defs/point" },
        "end": { "$ref": "#/$defs/point" },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "thickness": { "type": "number", "exclusiveMinimum": 0 },
        "tiltDegrees": { "type": "number", "minimum": -90, "maximum": 90 }
      },
      "additionalProperties": false
    },
    "opening": {
      "type": "object",
      "required": ["id", "kind", "hostWallId", "offset", "width", "height", "state"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "kind": { "enum": ["door", "window"] },
        "hostWallId": { "type": "string", "format": "uuid" },
        "offset": { "type": "number", "minimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "state": { "enum": ["closed", "open"] }
      },
      "additionalProperties": false
    }
  }
}
