
{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "@tarquinen/opencode-dcp@latest"
  ],
  "mcp": {
    "servers": {
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "headers": {
          "Authorization": "Bearer {env:GITHUB_MCP_TOKEN}",
          "X-MCP-Toolsets": "repos,issues,pull_requests"
        },
        "oauth": false
      }
    }
  },
  "instructions": [
    "AGENTS.md"
  ]
}
